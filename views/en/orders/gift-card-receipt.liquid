{% if gift_card.recipient %}
  {% if gift_card.recipient.nickname != blank %}
    {% assign recipient_name = gift_card.recipient.nickname %}
  {% elsif gift_card.recipient.name != blank %}
    {% assign recipient_name = gift_card.recipient.name %}
  {% else %}
    {% assign recipient_name = gift_card.recipient.email %}
  {% endif %}
  {% capture email_title %}
    {% if gift_card.send_on != blank %}
      You sent a gift card to {{ recipient_name }}
    {% endif %}
  {% endcapture %}
{% endif %}


<!doctype html>
<html lang="en">
  <head>
    <title>{{ email_title }}</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width">
    <link rel="stylesheet" type="text/css" href="/assets/notifications/styles.css">
    <style>
      .button__cell { background: {{ shop.email_accent_color }}; }
      a, a:hover, a:active, a:visited { color: {{ shop.email_accent_color }}; }
      @media (max-width: 639px) {
        .footer-link {
          padding-right: 20px !important; /* Adjust padding for smaller screens */
        }
      }
    </style>
    
  </head>

  <body class="bg-day mx-4 font-sans" style="margin-left: 1rem; margin-right: 1rem; background-color: #F9F8F2; font-family: Courier New, sans-serif;">
     <div style="background-color: #F9F8F2; width: 100%;">
   <div class="giftcard__body">
    {% if shop.email_logo_url %}
      <div class="text-center" style="text-align: center;">
        <img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" class="giftcard__logosize" width="{{ shop.email_logo_width }}">
      </div>
    {% endif %}
    <div class="text-center pt-8" style="padding-top: 2rem; text-align: center;">
       <img src="https://cdn.shopify.com/s/files/1/0870/1372/0337/files/logo_text.png?v=1742412071" alt="logo" class>
    </div>
    <div class="text-center pt-8" style="padding-top: 2rem; text-align: center;">
      <img src="https://cdn.shopify.com/s/files/1/0992/9092/files/A_GIFT_FOR_YOU_2.png?v=1733861831" alt="Gift Card" class="w-60" style="width: 15rem;">
    </div>

    <div class="pt-8 text-center uppercase text-xl max-w-[200px] mx-auto font-sans" style="margin-left: auto; margin-right: auto; max-width: 200px; padding-top: 2rem; text-align: center; font-family: Courier New, sans-serif; font-size: 1.25rem; line-height: 1.75rem; text-transform: uppercase;">
      {{ email_title }}
    </div>

    {% if gift_card.recipient and gift_card.message != blank %}
      <div class="text-center text-sm pt-8 mx-auto font-sans" style="margin-left: auto; margin-right: auto; padding-top: 2rem; text-align: center; font-family: Courier New, sans-serif; font-size: 0.875rem; line-height: 1.25rem; max-width: 100%; width: 90%; height: auto; max-width: 600px;">
        "{{ gift_card.message }}"
      </div>
    {% endif %}

   <table class="mx-auto max-w-[600px] mt-6" style="margin-left: auto; margin-right: auto; margin-top: 1.5rem; max-width: 100%; width: 90%; height: auto; max-width: 600px;">
    <tr style="border-bottom: 1px solid black;">
      <td class="text-left uppercase py-5 text-xs font-sans" style="padding-top: 1.25rem; padding-bottom: 1.25rem; text-align: left; font-family: Courier New, sans-serif; font-size: 0.75rem; line-height: 1rem; text-transform: uppercase;">Amount</td>
      <td class="text-right uppercase py-5 text-xs font-sans" style="padding-top: 1.25rem; padding-bottom: 1.25rem; text-align: right; font-family: Courier New, sans-serif; font-size: 0.75rem; line-height: 1rem; text-transform: uppercase;">Online Code</td>
    </tr>
    <tr style="border-bottom: 1px solid black;">
      <td class="text-left py-5 text-sm font-sans" style="padding-top: 1.25rem; padding-bottom: 1.25rem; text-align: left; font-family: Courier New, sans-serif; font-size: 0.875rem; line-height: 1.25rem;">{{ gift_card.initial_value | money_with_currency }}</td>
      <td class="text-right py-5 text-sm font-sans" style="padding-top: 1.25rem; padding-bottom: 1.25rem; text-align: right; font-family: Courier New, sans-serif; font-size: 0.875rem; line-height: 1.25rem;">{{ gift_card.code | format_code }}</td>
    </tr>
  </table>


    <div class="actions text-center pt-5" style="padding-top: 1.25rem; text-align: center;">
      <a href="{{ shop.url }}" class="button__text bg-black text-white py-5 px-10 inline-block uppercase max-w-80 w-3/4 font-sans" style="display: inline-block; width: 75%; max-width: 20rem; background-color: #000000; padding-left: 2.5rem; padding-right: 2.5rem; padding-top: 1.25rem; padding-bottom: 1.25rem; font-family: Courier New, sans-serif; text-transform: uppercase; color: #ffffff;">VISIT STORE</a>
    </div>
    <div class="text-center pt-5 pb-8" style="padding-bottom: 2rem; padding-top: 1.25rem; text-align: center;">
      <a href="{{ gift_card.url }}" class="link__text uppercase font-sans" style="font-family: Courier New, sans-serif; text-transform: uppercase; color: black;">View gift card balance 
        <span class="pl-2" style="padding-left: 0.5rem;">
          <img src="https://cdn.shopify.com/s/files/1/0870/1372/0337/files/Icon_-_Right.png?v=1742413093" alt="view gift card balance" class="w-3" style="width: 0.75rem;">
        </span>
      </a>
    </div>
    <div class="mx-auto max-w-[600px]" style="margin-left: auto; margin-right: auto; border-bottom: 1px solid black; max-width: 100%; width: 90%; height: auto; max-width: 600px;"></div>

    <div class="text-center pt-8 -mx-4" style="margin-left: -1rem; margin-right: -1rem; padding-top: 2rem; text-align: center;">
      <a href="{{ shop.url }}">
      <img src="https://cdn.shopify.com/s/files/1/0992/9092/files/Shop_Oil.png?v=1741200428" alt="Shop All" style="max-width: 100%; width: 90%; height: auto; max-width: 384px;">
      </a>
    </div>

    <div class="py-8 text-center max-w-[600px] mx-auto" style="margin-left: auto; margin-right: auto; max-width: 600px; padding-top: 2rem; padding-bottom: 2rem; text-align: center;">
      <p class="pb-5 uppercase text-black text-sm font-bold font-sans" style="padding-bottom: 1.25rem; font-family: Courier New, sans-serif; font-size: 0.875rem; line-height: 1.25rem; font-weight: 700; text-transform: uppercase; color: #000000;">USE EVERY DAY / ALL OVER</p>
      <p class="pb-5 text-black text-sm font-sans" style="padding-bottom: 1.25rem; font-family: Courier New, sans-serif; font-size: 0.875rem; line-height: 1.25rem; color: #000000;">Certified organic and microbiome-friendly skincare for the face, body and hair (everywhere).</p>
      <p class="text-black text-sm font-sans" style="font-family: Courier New, sans-serif; font-size: 0.875rem; line-height: 1.25rem; color: #000000;">Everyday Oil balances with your skin's natural oils to cleanse as it nourishes, absorbing quickly and leaving a dewy glow. This gentle approach to skincare protects your delicate microbiome and is non-comedogenic. Our sustainable, concentrated formula works best with water.</p>
    </div>
    
</div>


<!-- Footer -->
<table class="row footer" style="border-top: 1px solid black;">
  <tr>
    <td class="text-center pt-5" colspan="3" style="padding-top: 1.25rem; text-align: center;">
     <svg xmlns="http://www.w3.org/2000/svg" width="103" height="30" viewBox="0 0 103 30" fill="none">
      <path d="M47.1732 30C64.2336 29.977 78.7649 29.9934 80.6518 29.9934C82.1067 29.9934 91.1234 29.9844 103 29.9893C102.068 13.3413 79.4105 0 51.5021 0C23.5937 0 0.933909 13.3372 0 29.9869C7.4372 29.9893 12.6427 29.9934 13.722 29.9934C15.6081 29.9934 30.1269 29.977 47.1732 30Z" fill="#F2BA39"/>
     </svg>
    </td>
  </tr>
  
  <tr>
    <td class="text-center pt-5" colspan="3" style="padding-top: 1.25rem; text-align: center;">
      <a href="{{ shop.url }}/shop" class="footer-link underline font-sans pr-12" style="text-decoration-line: underline; font-family: 'Courier New', Courier, monospace; padding-right: 3rem; color: black; text-decoration: underline;">Shop</a>
      <a href="{{ shop.url }}/faq" class="footer-link underline font-sans pr-12" style="text-decoration-line: underline; font-family: 'Courier New', Courier, monospace; padding-right: 3rem; color: black; text-decoration: underline;">FAQ</a>
      <a href="{{ shop.url }}/account" class="footer-link underline font-sans pr-12" style="text-decoration-line: underline; font-family: 'Courier New', Courier, monospace; padding-right: 3rem; color: black; text-decoration: underline;">Account</a>
      <a href="{{ shop.url }}/contact" class="underline font-sans" style="text-decoration-line: underline; font-family: 'Courier New', Courier, monospace; color: black; text-decoration: underline;">Contact</a>
    </td>
  </tr>
  
  <tr>
    <td class="text-center pt-5 pb-5" style="padding-bottom: 1.25rem; padding-top: 1.25rem; text-align: center;">
      <p class="text-black font-sans" style="font-family: Courier New, sans-serif; color: #000000;">
        If you have any questions, reply to this email or contact us at
        <a style="color: black !important; text-decoration: underline !important; font-family: 'Courier New', Courier, monospace;" href="mailto:{{ shop.email }}">{{ shop.email }}</a>
      </p>
    </td>
  </tr>
</table>
      </div>
  </body>
</html>