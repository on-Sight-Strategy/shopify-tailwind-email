                                                    <p style="padding-bottom: 5px;"><span style="font-size:12px; text-transform: uppercase;">{{ line.variant.title }}</span></p>
                                                    <p style="padding-bottom:0; text-transform:uppercase"><span style="font-size:12px;">{{ line.price | money }} each</span></p>
