{% capture email_title %}Your order has been delivered {% endcapture %}
{% capture email_body %}
  Haven’t received your order? <a class="local-delivered-text-link" href="mailto:{{ shop.email }}">Let us know</a>.
{% endcapture %}

<!DOCTYPE html>
<html lang="en">
  <head>
  <title>{{ email_title }}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width">
  <link rel="stylesheet" type="text/css" href="/assets/notifications/styles.css">
  <style>
    .button__cell { background: {{ shop.email_accent_color }}; }
    .actions-buttons .button__cell--primary { background-color: {{ shop.email_accent_color }}; }
    a, a:hover, a:active, a:visited { color: {{ shop.email_accent_color }}; }

    /* Cap entire notification (including hero) at 800px, centered */
    table.local-delivered-email-shell {
      width: 100% !important;
      max-width: 800px !important;
      margin-left: auto !important;
      margin-right: auto !important;
    }

    /* Full-bleed main column — override Shopify notifications .container (560px) + centered caps */
    table.body > tbody > tr > td > center {
      width: 100% !important;
      max-width: 100% !important;
    }

    table.body table.container {
      width: 100% !important;
      max-width: 100% !important;
    }

    table.body .spacer {
      min-width: 0 !important;
      width: 100% !important;
    }

    /* Full-bleed hero row (override notification body padding only on hero row td) */
    .local-delivered-body__hero-shell { padding: 0 !important; margin: 0 !important; width: 100% !important; line-height: 0 !important; }

    /* Same hero imagery + swap as shipping / order confirmation (tombihn.com heroes) */
    .local-delivery-hero img.order-confirmation-hero-desktop,
    .local-delivery-hero img.order-confirmation-hero-mobile {
      width: 100% !important;
      max-width: 100% !important;
      height: auto !important;
      padding: 0 !important;
      margin: 0 !important;
    }
    .kmImage { border: 0; outline: none; text-decoration: none; display: inline !important; vertical-align: top; max-width: 100%; height: auto; }
    a .order-confirmation-hero-mobile {
      display: none !important;
      max-height: 0 !important;
      overflow: hidden !important;
    }

    a .shop-category-img-mobile {
      display: none !important;
      max-height: 0 !important;
      overflow: hidden !important;
    }

    /* Order-confirmation footer: Shop By Category → crew (desktop) */
    table.trust-bar-inner {
      width: 100% !important;
      max-width: none !important;
      margin-left: auto;
      margin-right: auto;
      border-collapse: collapse;
      table-layout: fixed
    }

    table.trust-bar-inner td.trust-bar-col {
      width: 33.333% !important;
      min-width: 0;
      box-sizing: border-box
    }

    table.shop-category-grid-inner {
      width: 100% !important;
      max-width: none !important;
      margin-left: auto;
      margin-right: auto;
      border-collapse: collapse;
      table-layout: fixed
    }

    table.shop-category-grid-inner td.shop-category-half {
      width: 50% !important;
      min-width: 0;
      box-sizing: border-box
    }

    table.shop-category-grid-inner td.shop-category-third {
      width: 33.333% !important;
      min-width: 0;
      box-sizing: border-box
    }

    table.shop-category-grid-inner img.shop-category-img {
      width: 100% !important;
      max-width: 100% !important;
      height: auto !important
    }

    td.customer-favorites-section {
      width: 100%;
      max-width: 100%;
      box-sizing: border-box
    }

    td.customer-favorites-grid-wrap {
      width: 100%;
      max-width: 100%;
      box-sizing: border-box
    }

    table.customer-favorites-inner {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
      border-collapse: separate !important;
      border-spacing: 0 !important;
      table-layout: fixed !important
    }

    table.customer-favorites-inner td.customer-favorites-card-cell {
      vertical-align: top;
      box-sizing: border-box !important;
      overflow: hidden;
      padding: 12px !important
    }

    table.customer-favorites-inner td.customer-favorites-gap {
      width: 12px !important;
      min-width: 12px !important;
      max-width: 12px !important;
      padding: 0 !important;
      margin: 0 !important;
      font-size: 0 !important;
      line-height: 0 !important;
      overflow: hidden !important;
      vertical-align: top !important;
      border: 0 !important
    }

    table.customer-favorites-inner img.customer-favorites-product-img {
      width: 100% !important;
      max-width: 100% !important;
      height: 204px !important;
      max-height: 204px !important;
      object-fit: contain !important;
      object-position: center center !important;
      border: 0 !important;
      margin: 0 !important
    }

    table.customer-favorites-inner p.customer-favorites-title {
      margin: 0 0 4px !important;
      padding: 0 !important;
      word-break: break-word !important;
      overflow-wrap: break-word !important
    }

    table.customer-favorites-inner p.customer-favorites-price {
      margin: 0 !important;
      padding: 0 !important
    }

    p.crew-footer-best-regards {
      font-size: 14px !important;
      font-style: italic !important
    }

    p.crew-footer-crew-title {
      font-size: 36px !important
    }

    /* Undo notifications/styles.css span { font-size: 16px } so “TOM BIHN” matches the rest */
    p.crew-footer-crew-title span {
      font-size: inherit !important;
      font-weight: inherit !important;
      font-family: inherit !important;
      line-height: inherit !important;
      color: inherit !important;
    }

    img.crew-footer-airplane-img {
      display: block !important;
      margin-left: auto !important;
      margin-right: auto !important;
      width: 158px !important;
      height: 94px !important;
      max-width: 158px !important;
      max-height: 94px !important;
      object-fit: contain !important;
      border: 0 !important
    }

    @media only screen and (max-width: 480px) {
      a .order-confirmation-hero-desktop {
        display: none !important;
        max-height: 0 !important;
        overflow: hidden !important;
      }
      a .order-confirmation-hero-mobile {
        display: block !important;
        max-height: none !important;
        overflow: visible !important;
      }

      a .shop-category-img-desktop {
        display: none !important;
        max-height: 0 !important;
        overflow: hidden !important;
      }

      a .shop-category-img-mobile {
        display: block !important;
        max-height: none !important;
        overflow: visible !important;
      }

      .local-delivered-title {
        font-size: 22px !important;
      }

      table.customer-favorites-inner img.customer-favorites-product-img {
        height: 131px !important;
        max-height: 131px !important;
        min-height: 0 !important
      }

      table.customer-favorites-inner p.customer-favorites-title {
        font-size: 12px !important
      }

      table.customer-favorites-inner p.customer-favorites-price {
        font-size: 10px !important
      }

      td.customer-favorites-section {
        padding: 20px 9px !important;
        max-width: 100% !important;
        width: 100% !important;
        box-sizing: border-box !important
      }

      td.customer-favorites-grid-wrap {
        padding: 12px 0 0 !important;
        max-width: 100% !important;
        width: 100% !important;
        box-sizing: border-box !important
      }

      table.customer-favorites-inner {
        max-width: 100% !important;
        width: 100% !important;
        min-width: 100% !important;
        margin: 0 !important;
        table-layout: fixed !important;
        border-spacing: 0 !important
      }

      table.customer-favorites-inner td.customer-favorites-card-cell {
        min-width: 0 !important;
        box-sizing: border-box !important;
        padding: 12px !important
      }

      table.customer-favorites-inner td.customer-favorites-gap {
        width: 8px !important;
        min-width: 8px !important;
        max-width: 8px !important
      }

      p.crew-footer-best-regards {
        font-size: 12px !important
      }

      p.crew-footer-crew-title {
        font-size: 24px !important
      }

      p.tom-bihn-section-heading {
        font-size: 20px !important
      }

      img.crew-footer-airplane-img {
        width: 124px !important;
        height: 73px !important;
        max-width: 124px !important;
        max-height: 73px !important
      }
    }



    .local-delivered-title {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 24px;
      font-weight: 700;
      line-height: 1.2;
      margin: 24px 0 0 0;
      padding: 0;
      mso-ansi-font-weight: bold;
    }

    .local-delivered-intro {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 13px;
      margin: 11px 0 0 0;
      padding: 0;
    }

    a.local-delivered-text-link,
    a.local-delivered-text-link:hover,
    a.local-delivered-text-link:active,
    a.local-delivered-text-link:visited {
      color: #000000 !important;
      font-family: Helvetica, Arial, sans-serif !important;
      font-size: 13px !important;
      text-decoration: underline !important;
    }

    .local-delivered-secondary-link-copy {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 13px;
    }

    .local-delivered-cta-row .main-action-cell {
      margin-right: 0 !important;
    }

    /* Divider above Items in delivery: full container width (#EEE), same edge as headline / Items list */
    .local-delivered-items-section {
      border-top: none !important;
    }

    /* 32px side inset for transactional + items/contact (hero stays full bleed) */
    table.body table.row.content td.content__cell {
      padding-left: 32px !important;
      padding-right: 32px !important;
    }

    .local-delivered-items-section td.section__cell {
      padding-top: 0 !important;
      padding-left: 32px !important;
      padding-right: 32px !important;
      padding-bottom: 40px !important;
      mso-padding-top-alt: 0;
    }

    .local-delivered-section-rule__line {
      border-top: 1px solid #eeeeee !important;
      font-size: 0 !important;
      line-height: 0 !important;
      height: 1px !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    /* View your order primary CTA (scoped so Visit our store / other buttons unchanged) */
    .local-delivered-view-order-btn .button__cell {
      background-color: #3489A2 !important;
      padding: 12px 24px !important;
    }

    .local-delivered-view-order-btn .button__text,
    .local-delivered-view-order-btn .button__text:hover,
    .local-delivered-view-order-btn .button__text:active,
    .local-delivered-view-order-btn .button__text:visited {
      color: #ffffff !important;
      font-family: Helvetica, Arial, sans-serif !important;
      font-size: 14px !important;
      font-weight: 700 !important;
      text-decoration: none !important;
      line-height: 1.25 !important;
      mso-ansi-font-weight: bold;
    }

    p.local-delivered-contact-copy {
      margin: 16px 0 0 !important;
      padding: 0 !important;
      font-family: Helvetica, Arial, sans-serif !important;
      font-size: 12px !important;
      line-height: 1.5 !important;
      color: #333333 !important;
    }

    p.local-delivered-contact-copy a,
    p.local-delivered-contact-copy a:hover,
    p.local-delivered-contact-copy a:visited,
    p.local-delivered-contact-copy a:active {
      font-family: Helvetica, Arial, sans-serif !important;
      font-size: 12px !important;
      line-height: 1.5 !important;
      color: #333333 !important;
      text-decoration: underline !important;
    }
  </style>
</head>

  <body style="margin:0;padding:0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin:0;padding:0;">
      <tr>
        <td align="center" valign="top" style="padding:0;">
    <table class="body local-delivered-email-shell" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:800px;margin:0 auto;padding:0;">
      <tr>
        <td class="local-delivered-body__hero-shell" width="100%" style="padding:0 !important;margin:0;line-height:0;width:100%;">
          <table class="local-delivery-hero" width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="width:100%;margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;">
            <tr>
              <td style="padding:0;margin:0;line-height:0;border-collapse:collapse;" valign="top">
                <table border="0" cellpadding="0" cellspacing="0" class="kmImageBlock" style="width:100%;margin:0;padding:0;" width="100%">
                  <tbody>
                    <tr>
                      <td class="kmImageBlockInner" style="padding:0;margin:0;line-height:0;border-collapse:collapse;mso-padding-alt:0;" valign="top">
