          <table class="row section local-delivered-items-section">
  <tr>
    <td class="section__cell">
      <center>
        <table class="container">
          <tr>
            <td style="padding:0;">
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                <tr>
                  <td class="local-delivered-section-rule__line" style="padding:0;margin:0;height:1px;line-height:0;font-size:0;border-top:1px solid #eeeeee;">&nbsp;</td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
        <table class="container">
          <tr>
            <td>
              <h3 style="margin:0 0 16px;padding:0;font-family:Helvetica,Arial,sans-serif;font-size:20px;font-weight:700;line-height:1.3;color:#333333;">Items in delivery</h3>
            </td>
          </tr>
        </table>
        <table class="container">
          <tr>
            <td>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;margin:0;">
    {% for line in fulfillment.fulfillment_line_items %}
{% comment %} Skip child add-ons since they will be rendered under the parent line item {% endcomment %}
{% unless line.line_item.nested_line_child? %}
  {% assign pick_oli = line.line_item %}
  {% if pick_oli.presentment_title %}
    {% assign line_title = pick_oli.presentment_title %}
  {% elsif pick_oli.title %}
    {% assign line_title = pick_oli.title %}
  {% else %}
    {% assign line_title = pick_oli.product.title %}
  {% endif %}
  <tr>
    <td valign="middle" width="72" style="padding:16px 12px 16px 0;border-bottom:1px solid #dde2e5;width:72px;vertical-align:middle;">
      {% if pick_oli.image %}
        <img alt="" src="{{ pick_oli | img_url: 'compact_cropped' }}" width="72" style="display:block;width:72px;max-width:72px;height:auto;border-radius:4px;border:0;outline:none;text-decoration:none;" />
      {% else %}
        <img alt="" src="{{ 'notifications/no-image.png' | shopify_asset_url }}" width="72" style="display:block;width:72px;max-width:72px;height:auto;border-radius:4px;border:0;outline:none;text-decoration:none;" />
      {% endif %}
    </td>
    <td valign="middle" style="padding:16px 0;border-bottom:1px solid #dde2e5;vertical-align:middle;font-family:Helvetica,Arial,sans-serif;">
      <p style="margin:0;padding:0;font-size:14px;font-weight:700;line-height:1.3;color:#333333;">{% if line.quantity < pick_oli.quantity %}{{ line.quantity }} of {{ pick_oli.quantity }} × {% else %}{{ line.quantity }}x {% endif %}{{ line_title }}</p>
      {% if pick_oli.variant.title != 'Default Title' %}
        <p style="margin:4px 0 0;padding:0;font-size:12px;font-weight:400;line-height:1.4;color:#777777;">{{ pick_oli.variant.title }}</p>
      {% endif %}
      {% for group in pick_oli.groups %}
        {% if group.deliverable? %}
          <p style="margin:4px 0 0;padding:0;font-size:12px;font-weight:400;line-height:1.4;color:#777777;">For: {{ group.display_title }}</p>
        {% else %}
          <p style="margin:4px 0 0;padding:0;font-size:12px;font-weight:400;line-height:1.4;color:#777777;">Part of: {{ group.display_title }}</p>
        {% endif %}
      {% endfor %}
      {% if pick_oli.selling_plan_allocation %}
        <p style="margin:4px 0 0;padding:0;font-size:12px;font-weight:400;line-height:1.4;color:#777777;">{{ pick_oli.selling_plan_allocation.selling_plan.name }}</p>
      {% endif %}
      {% if pick_oli.refunded_quantity > 0 %}
        <p style="margin:4px 0 0;padding:0;font-size:12px;font-weight:600;line-height:1.4;color:#999999;">Refunded</p>
      {% endif %}
      {% if pick_oli.discount_allocations %}
        {% for discount_allocation in pick_oli.discount_allocations %}
          {% if discount_allocation.discount_application.target_selection != 'all' %}
          <p style="margin:4px 0 0;padding:0;font-size:12px;font-weight:400;line-height:1.4;color:#777777;"><img src="{{ 'notifications/discounttag.png' | shopify_asset_url }}" width="18" height="18" alt="" style="display:inline-block;vertical-align:middle;margin-right:4px;border:0;" />{{- discount_allocation.discount_application.title | upcase }} (-{{ discount_allocation.amount | money }})</p>
          {% endif %}
        {% endfor %}
      {% endif %}
    </td>
  </tr>
  {% if pick_oli.nested_line_parent? %}
    {% for child_line in pick_oli.nested_lines %}
  <tr>
    <td valign="middle" width="72" style="padding:16px 12px 16px 0;border-bottom:1px solid #dde2e5;width:72px;vertical-align:middle;">
      {% if child_line.image %}
        <img alt="" src="{{ child_line | img_url: 'compact_cropped' }}" width="72" style="display:block;width:72px;max-width:72px;height:auto;border-radius:4px;border:0;outline:none;text-decoration:none;" />
      {% else %}
        <img alt="" src="{{ 'notifications/no-image.png' | shopify_asset_url }}" width="72" style="display:block;width:72px;max-width:72px;height:auto;border-radius:4px;border:0;outline:none;text-decoration:none;" />
      {% endif %}
    </td>
    <td valign="middle" style="padding:16px 0;border-bottom:1px solid #dde2e5;vertical-align:middle;font-family:Helvetica,Arial,sans-serif;">
      {% if child_line.product.title %}
        {% assign child_title = child_line.product.title %}
      {% else %}
        {% assign child_title = child_line.title %}
      {% endif %}
      <p style="margin:0;padding:0;font-size:14px;font-weight:700;line-height:1.3;color:#333333;">{{ child_line.quantity }}x {{ child_title }}</p>
      {% if child_line.variant.title != 'Default Title' %}
        <p style="margin:4px 0 0;padding:0;font-size:12px;font-weight:400;line-height:1.4;color:#777777;">{{ child_line.variant.title }}</p>
      {% endif %}
      {% if child_line.selling_plan_allocation %}
        <p style="margin:4px 0 0;padding:0;font-size:12px;font-weight:400;line-height:1.4;color:#777777;">{{ child_line.selling_plan_allocation.selling_plan.name }}</p>
      {% endif %}
    </td>
  </tr>
    {% endfor %}
  {% endif %}
{% endunless %}
    {% endfor %}
              </table>
            </td>
          </tr>
        </table>
