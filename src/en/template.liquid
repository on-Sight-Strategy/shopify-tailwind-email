<!-- Capture Variables -->
{% capture email_title %}Email Title{% endcapture %}
{% capture email_body %}Email Body{% endcapture %}

<!doctype html>
<html lang='en'>
  <head>
    <title>{{ email_title }}</title>
    <meta http-equiv='Content-Type' content='text/html; charset=utf-8'>
    <meta name='viewport' content='width=device-width'>
    <link rel='stylesheet' type='text/css' href='/assets/notifications/styles.css'>
    <!-- Email Styles -->
    <style>
      .button__cell {
        background: #090d1c;
      }
      a,
      a:hover,
      a:active,
      a:visited {
        color: #090d1c;
      }

      body,
      td {
        font-family: Tahoma, 'Helvetica Neue', sans-serif;
      }

      .white {
        color: white;
      }

      .dark {
        color: #090d1c;
      }

      .onyx {
        color: #121212;
      }

      .blue {
        color: #0b76a0;
      }

      .gray {
        color: #777777;
      }

      .gray-md {
        color: #555555;
      }

      .border-c {
        border-color: #cccccc;
      }

      .order-list__item-title {
        font-size: 1rem;
        font-weight: 400;
        color: #121212;
      }

      .order-list__item-variant {
        font-size: 14px;
        color: #777777;
      }

      .order-list__item-price,
      .order-list__item-original-price,
      strong {
        color: #121212;
      }

      .order-list__item-discount-allocation {
        font-size: 14px;
        color: #777777;
        text-transform: uppercase;
      }

      .order-list__item {
        border-top: 0px;
        border-bottom: 1px solid #cccccc;
      }

      .order-list__item__cell {
        padding-top: 16px;
        padding-bottom: 16px;
        padding-left: 0;
        padding-right: 0;
      }

      .order-list__product-image {
        margin-right: 1rem;
        border: 0;
        width: 4rem;
        height: 4rem;
      }

      .subtotal-lines {
        margin-top: 1rem;
        border: 0;
      }

      table.container {
        width: 100%;
      }

      .section__cell {
        padding: 24px 20px;
      }
    </style>
  </head>

  <body>
    <div class='container mx-auto' style='margin-left: auto; margin-right: auto;'>
      <!-- Header -->
      <div class>
        <a href='{{ shop.url }}'>
          <img
            class='w-full'
            src='{{ "email-header.png" | file_url }}'
            width='560'
            alt='Header Image for {{ shop.name }}'
            style='width: 100%;'
          >
        </a>
      </div>
      <!-- End of Header -->

      <!-- Order Status -->
      <div
        class='py-6 px-5'
        style='padding-left: 1.25rem; padding-right: 1.25rem; padding-top: 1.5rem; padding-bottom: 1.5rem;'
      >
        <table>
          <tr>
            <td>
              <p class='uppercase onyx' style='text-transform: uppercase;'>Order {{ order_name }}</p>
              <h2 class='mt-5 text-2xl onyx' style='margin-top: 1.25rem; font-size: 1.5rem; line-height: 2rem;'>
                {{ email_title }}
              </h2>
              <p class='onyx'>{{ email_body }}</p>

              {% if order_status_url %}
                <table class='row actions'>
                  <tr>
                    <td class='empty-line'>&nbsp;</td>
                  </tr>
                  <tr>
                    <td class='actions__cell'>
                      <table class='button main-action-cell'>
                        <tr>
                          <td class='button__cell rounded-full' style='border-radius: 9999px;'>
                            <a href='{{ order_status_url }}' class='button__text'>View your order</a>
                          </td>
                        </tr>
                      </table>
                      {% if shop.url %}
                        <table class='link secondary-action-cell'>
                          <tr>
                            <td class='link__cell'>or <a href='{{ shop.url }}'>Visit our store</a></td>
                          </tr>
                        </table>
                      {% endif %}
                    </td>
                  </tr>
                </table>
              {% else %}
                {% if shop.url %}
                  <table class='row actions'>
                    <tr>
                      <td class='actions__cell'>
                        <table class='button main-action-cell'>
                          <tr>
                            <td class='button__cell rounded-full' style='border-radius: 9999px;'>
                              <a href='{{ shop.url }}' class='button__text'>Visit our store</a>
                            </td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  </table>
                {% endif %}
              {% endif %}
            </td>
          </tr>
        </table>
      </div>
      <!-- End Order Status -->

      <!-- EMAIL CONTENT -->
      ...
      <!-- END EMAIL CONTENT -->

      <!-- Pre-Footer: Questions -->
      <div class>
        <table class='w-full' style='width: 100%;'>
          <tr>
            <td
              class='px-5 border-solid py-9 border-0 border-t border-c'
              style='border-width: 0px; border-top-width: 1px; border-style: solid; padding-left: 1.25rem; padding-right: 1.25rem; padding-top: 2.25rem; padding-bottom: 2.25rem;'
            >
              <p
                class='text-sm onyx text-center'
                style='text-align: center; font-size: 0.875rem; line-height: 1.25rem;'
              >
                If you have any questions, reply to this email or contact us at
                <a href='mailto:{{ shop.email }}' class='dark'>{{ shop.email }}</a>
              </p>
            </td>
          </tr>
        </table>
      </div>

      <!-- Footer -->
      <div style='padding: 56px 0; width: 100%; background-color: #090D1C; background: linear-gradient(to bottom, #090D1C, #0A293F);'>
        <table class='w-full' style='width: 100%;'>
          <thead class='block' style='display: block;'>
            <tr
              class='w-fit block mx-auto'
              style='margin-left: auto; margin-right: auto; display: block; width: -moz-fit-content; width: fit-content;'
            >
              <td scope='col'>
                <p
                  class='text-xl font-bold w-28 white pr-7'
                  style='width: 7rem; padding-right: 1.75rem; font-size: 1.25rem; line-height: 1.75rem; font-weight: 700;'
                >
                  Support
                </p>
              </td>
              <td scope='col'>
                <p
                  class='text-xl font-bold w-28 white pl-7'
                  style='width: 7rem; padding-left: 1.75rem; font-size: 1.25rem; line-height: 1.75rem; font-weight: 700;'
                >
                  Learn
                </p>
              </td>
            </tr>
          </thead>
          <tbody class='block pt-5' style='display: block; padding-top: 1.25rem;'>
            <tr
              class='w-fit block mx-auto'
              style='margin-left: auto; margin-right: auto; display: block; width: -moz-fit-content; width: fit-content;'
            >
              <td scope='col' class='w-28 pr-7' style='width: 7rem; padding-right: 1.75rem;'>
                <a href='https://myvega.com/blogs/faqs'>
                  <span class='white text-sm' style='font-size: 0.875rem; line-height: 1.25rem;'>FAQs</span>
                </a>
              </td>
              <td scope='col' class='w-28 pl-7' style='width: 7rem; padding-left: 1.75rem;'>
                <a href='https://myvega.com/pages/our-story'>
                  <span class='white text-sm' style='font-size: 0.875rem; line-height: 1.25rem;'>Our Story</span>
                </a>
              </td>
            </tr>
            <tr
              class='w-fit block mx-auto'
              style='margin-left: auto; margin-right: auto; display: block; width: -moz-fit-content; width: fit-content;'
            >
              <td scope='col' class='w-28 pr-7' style='width: 7rem; padding-right: 1.75rem;'>
                <a href='https://myvega.com/pages/contact'>
                  <span class='white text-sm' style='font-size: 0.875rem; line-height: 1.25rem;'>Get in Touch</span>
                </a>
              </td>
              <td scope='col' class='w-28 pl-7' style='width: 7rem; padding-left: 1.75rem;'>
                <a href='https://myvega.com/blogs/content'>
                  <span class='white text-sm' style='font-size: 0.875rem; line-height: 1.25rem;'>Blog</span>
                </a>
              </td>
            </tr>
            <tr
              class='w-fit block mx-auto'
              style='margin-left: auto; margin-right: auto; display: block; width: -moz-fit-content; width: fit-content;'
            >
              <td scope='col' class='w-28 pr-7' style='width: 7rem; padding-right: 1.75rem;'>
                <a href='https://myvega.com/pages/store-locator'>
                  <span class='white text-sm' style='font-size: 0.875rem; line-height: 1.25rem;'>Store Locator</span>
                </a>
              </td>
              <td scope='col' class='w-28 pl-7' style='width: 7rem; padding-left: 1.75rem;'>
                <a href='https://myvega.com/blogs/recipes'>
                  <span class='white text-sm' style='font-size: 0.875rem; line-height: 1.25rem;'>Recipes</span>
                </a>
              </td>
            </tr>
            <tr
              class='w-fit block mx-auto'
              style='margin-left: auto; margin-right: auto; display: block; width: -moz-fit-content; width: fit-content;'
            >
              <td scope='col' class='w-28 pr-7' style='width: 7rem; padding-right: 1.75rem;'>
                <span>
                  <span class='white text-sm' style='font-size: 0.875rem; line-height: 1.25rem;'></span>
                </span>
              </td>
              <td scope='col' class='w-28 pl-7' style='width: 7rem; padding-left: 1.75rem;'>
                <a href='https://myvega.com/pages/careers'>
                  <span class='white text-sm' style='font-size: 0.875rem; line-height: 1.25rem;'>Careers</span>
                </a>
              </td>
            </tr>
          </tbody>
        </table>

        <div class='h-12' style='height: 3rem;'></div>

        <table class='w-full' style='width: 100%;'>
          <tbody class='block pt-5' style='display: block; padding-top: 1.25rem;'>
            <tr
              class='w-fit block mx-auto'
              style='margin-left: auto; margin-right: auto; display: block; width: -moz-fit-content; width: fit-content;'
            >
              <td
                scope='col'
                class='w-5 pr-2 pl-2'
                style='width: 1.25rem; padding-left: 0.5rem; padding-right: 0.5rem;'
              >
                <a
                  href='https://www.instagram.com/vegaplantnutrition'
                  class='white text-sm'
                  style='font-size: 0.875rem; line-height: 1.25rem;'
                >
                  <img
                    src='{{ "Icon-Instagram.svg" | file_url }}'
                    width='20'
                    height='20'
                    alt='Instagram'
                    style='display: block;'
                  >
                </a>
              </td>
              <td
                scope='col'
                class='w-5 pr-2 pl-2'
                style='width: 1.25rem; padding-left: 0.5rem; padding-right: 0.5rem;'
              >
                <a
                  href='https://www.facebook.com/VegaPlantNutrition/'
                  class='white text-sm'
                  style='font-size: 0.875rem; line-height: 1.25rem;'
                >
                  <img
                    src='{{ "Icon-Facebook.svg" | file_url }}'
                    width='20'
                    height='20'
                    alt='Facebook'
                    style='display: block;'
                  >
                </a>
              </td>
              <td
                scope='col'
                class='w-5 pr-2 pl-2'
                style='width: 1.25rem; padding-left: 0.5rem; padding-right: 0.5rem;'
              >
                <a
                  href='https://www.tiktok.com/@vegaplantnutrition'
                  class='white text-sm'
                  style='font-size: 0.875rem; line-height: 1.25rem;'
                >
                  <img
                    src='{{ "Icon-TikTok.svg" | file_url }}'
                    width='20'
                    height='20'
                    alt='TikTok'
                    style='display: block;'
                  >
                </a>
              </td>
              <td
                scope='col'
                class='w-5 pr-2 pl-2'
                style='width: 1.25rem; padding-left: 0.5rem; padding-right: 0.5rem;'
              >
                <a
                  href='https://x.com/vegateam'
                  class='white text-sm'
                  style='font-size: 0.875rem; line-height: 1.25rem;'
                >
                  <img src='{{ "Icon_-_X.svg" | file_url }}' width='20' height='20' alt='X' style='display: block;'>
                </a>
              </td>
              <td
                scope='col'
                class='w-5 pr-2 pl-2'
                style='width: 1.25rem; padding-left: 0.5rem; padding-right: 0.5rem;'
              >
                <a
                  href='https://www.youtube.com/user/myvegatv'
                  class='white text-sm'
                  style='font-size: 0.875rem; line-height: 1.25rem;'
                >
                  <img
                    src='{{ "Icon-Youtube.svg" | file_url }}'
                    width='20'
                    height='20'
                    alt='Youtube'
                    style='display: block;'
                  >
                </a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <!-- End Footer -->
    </div>
  </body>
</html>
